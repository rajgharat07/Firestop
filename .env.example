# Copy to .env before running docker compose up.

# HydraDB requires an auth token of at least 32 characters.
HYDRADB_AUTH_TOKEN=local-development-token-32-characters

# Where the local HydraDB node listens. These match docker-compose.yml.
HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_BOLT_URL=bolt://127.0.0.1:7687
HYDRADB_ADMIN_URL=http://127.0.0.1:9090
HYDRADB_INDEXER_ADMIN_URL=http://127.0.0.1:9091
HYDRADB_NAMESPACE=firestop
HYDRADB_GRAPH_ID=default
HYDRADB_CELL_ID=cell-0

# Local S3-compatible object store. HydraDB keeps the durable graph here, and
# the indexer needs conditional-put support that a plain local directory does
# not provide. Console at http://127.0.0.1:9001.
HYDRADB_BUCKET=firestop
MINIO_ROOT_USER=firestop
MINIO_ROOT_PASSWORD=firestop-dev-secret

# npm registry crawl. The registry is unauthenticated; these exist to keep the
# crawl polite rather than to unlock anything.
NPM_REGISTRY_URL=https://registry.npmjs.org
CRAWL_CONCURRENCY=8
CRAWL_REQUESTS_PER_SECOND=15
CRAWL_MAX_PACKAGES=2000
